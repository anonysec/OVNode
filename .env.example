# This is the service port for the OVNode
SERVICE_PORT=2083

# This is an API key for connecting the master (panel) to the node.
# MUST be at least 16 characters. Generate with: openssl rand -hex 32
API_KEY=CHANGE_ME_to_a_long_random_string_at_least_16_chars

# OpenVPN port used by the server config and client templates
OPENVPN_PORT=1194

# OVManager panel base URL (e.g. https://panel.example.com:8443).
# When set, the client-connect hook enforces the GLOBAL (cross-node)
# max-login limit by querying the panel's /mlogin/status/{username}
# endpoint, authenticated with this node's name + API key.
# Leave empty to enforce limits per-node only.
# PANEL_URL=https://panel.example.com:8443

# Global check failure mode when the panel is unreachable:
# default fail-open (allow). Set to 1 to fail-closed (reject).
# OVNODE_GLOBAL_FAIL_CLOSED=0

# CORS: comma-separated list of allowed panel origins.
# Set this to your panel's public URL (e.g. https://panel.example.com).
# Leave empty to deny all cross-origin requests (recommended for production).
# PANEL_ORIGINS=https://panel.example.com

# ── OpenVPN server tuning (all optional) ─────────────────────────────
# User/group OpenVPN drops privileges to. Ensure the group exists
# (Debian/Ubuntu: nogroup, RHEL/Fedora: nobody).
# OVNODE_RUNTIME_USER=nobody
# OVNODE_RUNTIME_GROUP=nogroup

# Local management interface port (used for session takeover/disconnect).
# OVNODE_MANAGEMENT_PORT=7505

# VPN pool and DNS pushed to clients.
# OVNODE_VPN_NETWORK=10.8.0.0
# OVNODE_VPN_NETMASK=255.255.255.0
# OVNODE_VPN_DNS1=1.1.1.1
# OVNODE_VPN_DNS2=8.8.8.8

# Max simultaneous clients.
# OVNODE_MAX_CLIENTS=100

# IPv6 support (1 to enable). Adds a ULA pool + IPv6 route push.
# OVNODE_ENABLE_IPV6=0
# OVNODE_IPV6_PREFIX=fd42:42:42:42::/64

# Development: enable the OpenAPI docs at /doc and set log level (DEBUG/INFO/WARNING)
# DOC=True
# DEBUG=INFO
