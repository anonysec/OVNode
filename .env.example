# OVNode configuration. The installer writes this file with mode 0600; edit it
# only for deliberate overrides.
#
# OpenVPN tuning does NOT live here. It is /var/lib/<instance>/state/openvpn.json
# and is managed from the panel (protocol, port, DNS, routes, MTU, ciphers,
# keepalive, limits).

# ── Identity ───────────────────────────────────────────────────────────
# Selects /opt/<name>, /var/lib/<name>, /var/log/<name>, <name>.service and
# /usr/local/bin/<name>. Changing it means a reinstall.
Instance=ovnode

# ── Paths (defaults derive from Instance) ──────────────────────────────
DataDir=/var/lib/ovnode
OpenVpnRoot=/var/lib/ovnode/openvpn
LogDir=/var/log/ovnode

# ── Panel API ──────────────────────────────────────────────────────────
ApiPort=2083
# 64 hex characters: openssl rand -hex 32. Required, minimum 16.
ApiKey=CHANGE_ME_to_a_long_random_string_at_least_16_chars
# Comma-separated IPs/CIDRs allowed to call /sync.
# Empty = any address presenting a valid key.
ApiAllowedCidrs=

# ── TLS (empty = the node PKI's server certificate) ────────────────────
TlsCertFile=
TlsKeyFile=

# ── Runtime ────────────────────────────────────────────────────────────
RuntimeUser=nobody
RuntimeGroup=nogroup
# debug, info, warn or error
LogLevel=info
